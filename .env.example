# databases
LAWCORPUS_PG_DSN=postgresql://user:pass@<your-host>:5432/lawcorpus
LAWCORPUS_NEO4J_URI=bolt://<your-host>:7687
LAWCORPUS_NEO4J_USER=neo4j
LAWCORPUS_NEO4J_PASSWORD=

# ollama — 임베딩 + 리랭킹
LAWCORPUS_OLLAMA_BASE_URL=http://<your-host>:11434
# LAWCORPUS_EMBEDDING_MODEL=qwen3-embedding:8b
# LAWCORPUS_EMBEDDING_DIM=1024
# LAWCORPUS_RERANKER_MODEL=bge-reranker-v2-m3

# law.go.kr OPEN API (법제처 국가법령정보 공동활용, https://open.law.go.kr 에서 OC 신청)
# LAWCORPUS_LAW_API_BASE_URL=http://www.law.go.kr/DRF
LAWCORPUS_LAW_API_OC=

# retrieval 노브 (기본값 유지 권장)
# LAWCORPUS_RETRIEVE_TOP_K=30
# LAWCORPUS_RERANK_TOP_K=5
